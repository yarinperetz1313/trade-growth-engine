# Dependencies
node_modules/

# Environment and local machine configuration
.env
.env.*
!.env.example
.npmrc

# Runtime/developer data (local-first store)
data/

# Build output and generated reports
dist/
coverage/
test-results/
playwright-report/
blob-report/
artifacts/
test-artifacts/
playwright/.cache/

# Logs and caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.parcel-cache/
.vite/

# Local agent/tool artifacts
.atl/

# Secret and credential material
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
credentials.json
service-account*.json
*-credentials.json
.aws/
**/.aws/
.gcp/
**/.gcp/
.azure/
**/.azure/
.credentials/
**/.credentials/
secrets/
**/secrets/

# Allow intentional checked-in fixtures and examples
!.env.example
!test/fixtures/**
!test/fixtures/**/*.key
!test/fixtures/**/*.pem
!test/fixtures/**/*.crt
!test/fixtures/**/*.cer
!test/fixtures/**/*.der
!test/fixtures/**/*.p12
!test/fixtures/**/*.pfx

# Backup source artifacts
*.backup.*
*.bak
*.orig
backup/
backups/
.backup/
**/backup/
**/backups/
**/.backup/

# OS/editor noise
.DS_Store
